# frozen_string_literal: true

source "https://rubygems.org"

# Ruby 2.7+ recommended for local build. GitHub Pages uses Jekyll 3.9.
gem "jekyll", "~> 3.9"
gem "kramdown-parser-gfm"  # GitHub Flavored Markdown for kramdown
gem "jekyll-remote-theme"  # For Beautiful Jekyll theme (local build)
gem "jekyll-paginate"     # Required by Beautiful Jekyll
gem "jekyll-sitemap"      # Required by Beautiful Jekyll

# Required on Ruby 3.4+ (these were removed from default gems; Jekyll 3.x deps need them)
gem "base64"
gem "bigdecimal"
